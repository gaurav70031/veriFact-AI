# =============================================================================
# VeritasAI — Environment Variables
#
# 1. Copy this file:  cp .env.example .env
# 2. Fill in every value marked with <CHANGE_ME>
# 3. NEVER commit .env to version control — it is in .gitignore
#
# Generate a strong SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================


# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development                  # development | staging | production
SECRET_KEY=<CHANGE_ME>               # JWT signing key — must be random + secret
DEBUG=false
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR


# ── JWT / Auth ────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
COOKIE_SECURE=false                  # true in production (requires HTTPS)
COOKIE_SAMESITE=lax                  # lax | none (none requires secure=true)


# ── Backend server ────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000


# ── PostgreSQL ────────────────────────────────────────────────────────────────
# In Docker Compose, POSTGRES_HOST must be the service name: postgres
# In local development (no Docker), use: localhost
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=fakenews_db
POSTGRES_USER=fakenews_user
POSTGRES_PASSWORD=<CHANGE_ME>        # strong random password


# ── Redis (optional — used for caching) ──────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379


# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In Docker Compose, the frontend is at http://localhost (port 80).
# In production, use your actual domain: https://fakenews.example.com
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:5173


# ── ML artefacts ──────────────────────────────────────────────────────────────
# Path to the saved_models directory, relative to the backend working dir.
# In Docker Compose this is mounted at /app/ml/saved_models.
ML_SAVED_MODELS_DIR=ml/saved_models
TRANSFORMER_VERSION=1.0.0

# Set to "true" only when sentence-transformers model is cached locally.
# When false (default), the evidence comparator uses fast lexical comparison.
SENTENCE_TRANSFORMERS_ENABLED=false


# ── Evidence retrieval — News APIs ───────────────────────────────────────────
# Configure at least one provider for live evidence retrieval.
# The system gracefully skips unconfigured providers.

# NewsAPI (https://newsapi.org) — free tier: 100 req/day
NEWSAPI_KEY=

# GNews (https://gnews.io) — free tier: 100 req/day
GNEWS_API_KEY=

# Web search provider: serpapi | brave
SEARCH_PROVIDER=serpapi

# SerpAPI (https://serpapi.com)
SERPAPI_KEY=

# Brave Search API (https://api.search.brave.com)
BRAVE_SEARCH_KEY=

# Custom RSS feeds (comma-separated URLs).
# Leave empty to use the built-in default list.
RSS_FEED_URLS=


# ── Frontend ──────────────────────────────────────────────────────────────────
# Used by Vite at build time (not at runtime).
# In Docker Compose with nginx proxy: /api/v1 (relative — no host needed)
# In direct local dev (npm run dev): http://localhost:8000/api/v1
VITE_API_BASE_URL=/api/v1


# ── Docker Compose port overrides (optional) ─────────────────────────────────
FRONTEND_PORT=80
