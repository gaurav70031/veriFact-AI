# =============================================================================
# Fake News Detection — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-to-a-random-32-char-string
DEBUG=true
LOG_LEVEL=INFO

# ── Backend server ────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fakenews_db
POSTGRES_USER=fakenews_user
POSTGRES_PASSWORD=your-db-password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── ML artefacts ──────────────────────────────────────────────────────────────
# Relative to the project root; train models first with:
#   python scripts/train_baseline.py
#   python scripts/train_transformer.py
ML_SAVED_MODELS_DIR=ml/saved_models
TRANSFORMER_VERSION=1.0.0

# ── CORS (comma-separated origins) ───────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Evidence retrieval — News APIs ───────────────────────────────────────────
# At least one provider should be configured for evidence retrieval to work.
# The system gracefully skips unconfigured providers.

# NewsAPI (https://newsapi.org) — free tier: 100 req/day
NEWSAPI_KEY=

# GNews (https://gnews.io) — free tier: 100 req/day, 10 articles/req
GNEWS_API_KEY=

# ── Evidence retrieval — Web Search ──────────────────────────────────────────
# Choose one: serpapi | brave
SEARCH_PROVIDER=serpapi

# SerpAPI (https://serpapi.com) — Google Search results via API
SERPAPI_KEY=

# Brave Search API (https://api.search.brave.com)
BRAVE_SEARCH_KEY=

# ── Evidence retrieval — RSS feeds ───────────────────────────────────────────
# Comma-separated list of RSS feed URLs.
# Leave empty to use the built-in default list (Reuters, BBC, Guardian, etc.)
RSS_FEED_URLS=

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
